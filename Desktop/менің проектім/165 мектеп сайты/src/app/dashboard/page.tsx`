"use client";

import { useState, useEffect } from "react";
import { supabase } from "@/lib/supabase";
import Link from "next/link";
import { User, BookOpen, CheckCircle, TrendingUp, ArrowRight, LogOut } from "lucide-react";
import { cn } from "@/lib/utils";

export default function DashboardPage() {
  const [profile, setProfile] = useState<any>(null);
  const [stats, setStats] = useState({
    totalLessons: 0,
    completedLessons: 0,
    averageScore: 0,
    overallProgress: 0,
  });
  const [lastLesson, setLastLesson] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadDashboard() {
      try {
        const { data: { user: authUser } } = await supabase.auth.getUser();
        if (!authUser) {
          window.location.href = "/login";
          return;
        }

        // Fetch Profile
        const { data: profileData } = await supabase
          .from("profiles")
          .select("*")
          .eq("id", authUser.id)
          .single();
        setProfile(profileData);

        // Fetch Lessons for total count
        const { data: lessonsData } = await supabase.from("lessons").select("id");
        const total = lessonsData?.length || 0;

        // Fetch Progress
        const { data: progressData } = await supabase
          .from("progress")
          .select("*")
          .eq("user_id", authUser.id);

        const completed = progressData?.filter(p => p.video_completed && p.test_completed).length || 0;
        const scores = progressData?.filter(p => p.test_score !== null).map(p => p.test_score) || [];
        const avgScore = scores.length > 0
          ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length)
          : 0;

        const progressPercent = total > 0 ? Math.round((completed / total) * 100) : 0;

        setStats({
          totalLessons: total,
          completedLessons: completed,
          averageScore: avgScore,
          overallProgress: progressPercent,
        });

        // Find last started/completed lesson
        if (progressData && progressData.length > 0) {
          const sortedProgress = [...progressData].sort((a, b) =>
            new Date(b.completed_at || 0).getTime() - new Date(a.completed_at || 0).getTime()
          );
          const lastId = sortedProgress[0].lesson_id;
          const { data: lessonData } = await supabase.from("lessons").select("*").eq("id", lastId).single();
          setLastLesson(lessonData);
        }

      } catch (err) {
        console.error("Dashboard error:", err);
      } finally {
        setLoading(false);
      }
    }
    loadDashboard();
  }, []);

  async function handleLogout() {
    await supabase.auth.signOut();
    window.location.href = "/login";
  }

  if (loading) {
    return (
      <div className="container mx-auto px-4 py-20 flex flex-col items-center justify-center min-h-[60vh]">
        <div className="h-12 w-12 animate-spin rounded-full border-4 border-primary border-t-transparent" />
        <p className="mt-4 text-muted-foreground">Жеке кабинет жүктелуде...</p>
      </div>
    );
  }

  return (
    <div className="container mx-auto px-4 py-20">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
        <div>
          <h1 className="text-4xl font-extrabold mb-2">Қош келдіңіз, {profile?.first_name}! 👋</h1>
          <p className="text-muted-foreground">Сіздің оқу прогресіңіз бен жетістіктеріңіз</p>
        </div>
        <button
          onClick={handleLogout}
          className="flex items-center gap-2 px-4 py-2 rounded-xl border bg-background hover:bg-muted transition-colors text-sm font-medium"
        >
          <LogOut className="h-4 w-4" /> Шығу
        </button>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {/* Profile Card */}
        <div className="lg:col-span-1 space-y-6">
          <div className="p-8 rounded-3xl border bg-background shadow-sm flex flex-col items-center text-center">
            <div className="h-24 w-24 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-6">
              <User className="h-12 w-12" />
            </div>
            <h2 className="text-2xl font-bold mb-1">{profile?.last_name} {profile?.first_name}</h2>
            <p className="text-sm text-muted-foreground mb-6">{profile?.phone}</p>
            <div className="inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">
              {profile?.role === 'student' ? 'Оқушы' : 'Ата-ана'}
            </div>
          </div>

          <div className="p-8 rounded-3xl border bg-primary text-primary-foreground shadow-lg">
            <h3 className="text-xl font-bold mb-6 flex items-center gap-2">
              <TrendingUp className="h-6 w-6" /> Жалпы прогресс
            </h3>
            <div className="text-5xl font-black mb-4">{stats.overallProgress}%</div>
            <div className="h-3 w-full bg-white/20 rounded-full overflow-hidden">
              <div
                className="h-full bg-white transition-all duration-1000"
                style={{ width: `${stats.overallProgress}%` }}
              />
            </div>
            <p className="mt-4 text-sm text-primary-foreground/80">
              Барлық {stats.totalLessons} сабақтың {stats.completedLessons} сабағы аяқталды.
            </p>
          </div>
        </div>

        {/* Stats & Activity */}
        <div className="lg:col-span-2 space-y-8">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div className="p-6 rounded-3xl border bg-background flex items-center gap-6">
              <div className="h-12 w-12 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center">
                <CheckCircle className="h-6 w-6" />
              </div>
              <div>
                <p className="text-sm text-muted-foreground">Аяқталған сабақтар</p>
                <p className="text-2xl font-bold">{stats.completedLessons} / {stats.totalLessons}</p>
              </div>
            </div>
            <div className="p-6 rounded-3xl border bg-background flex items-center gap-6">
              <div className="h-12 w-12 rounded-2xl bg-blue-500/10 text-blue-500 flex items-center justify-center">
                <BookOpen className="h-6 w-6" />
              </div>
              <div>
                <p className="text-sm text-muted-foreground">Орташа нәтиже</p>
                <p className="text-2xl font-bold">{stats.averageScore}%</p>
              </div>
            </div>
          </div>

          <div className="p-8 rounded-3xl border bg-background shadow-sm">
            <h3 className="text-2xl font-bold mb-6">Соңғы оқылған сабақ</h3>
            {lastLesson ? (
              <div className="flex flex-col md:flex-row items-center justify-between gap-6 p-6 rounded-2xl bg-muted/30 border border-primary/20">
                <div className="flex items-center gap-4">
                  <div className="h-12 w-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-bold">
                    {lastLesson.order_index}
                  </div>
                  <div className="text-left">
                    <h4 className="text-lg font-bold">{lastLesson.title}</h4>
                    <p className="text-sm text-muted-foreground">Оқуды жалғастырыңыз</p>
                  </div>
                </div>
                <Link
                  href={`/unt/lesson/${lastLesson.id}`}
                  className="flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:opacity-90 transition-all"
                >
                  Жалғастыру <ArrowRight className="h-4 w-4" />
                </Link>
              </div>
            ) : (
              <div className="text-center py-12 text-muted-foreground">
                Әзірге ешқандай сабақ басталмаған. <br />
                <Link href="/unt" className="text-primary font-bold hover:underline">ҰБТ бөліміне өту</Link>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
